# Backend runtime settings
# Supabase shared session pooler, suitable for IPv4 networks.
SUPABASE_DB_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.ozaiknomajljfqiepels
SUPABASE_DB_PASSWORD=<your-password>
SUPABASE_DB_SSL_MODE=require

# Supabase JWT issuer for backend token validation
SUPABASE_JWT_ISSUER=https://ozaiknomajljfqiepels.supabase.co/auth/v1
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>

# Signing key for the tokens this backend issues itself (local email/password login).
# REQUIRED - the app refuses to start without it. Minimum 48 bytes (HS384).
# Generate a fresh one per environment: openssl rand -base64 48
APP_JWT_SECRET=<generate-with-openssl-rand-base64-48>
# APP_JWT_EXPIRATION=3600
# APP_JWT_REFRESH_EXPIRATION=2592000

# Frontend origin(s), comma-separated. Entries are matched as patterns, so "*" is allowed in a
# host segment - needed for Vercel, which mints a new <project>-<hash>-<team>.vercel.app host on
# every deployment. Keep patterns scoped to your own account; never use https://*.vercel.app.
# Example:
#   APP_CORS_ALLOWED_ORIGINS=https://datn-co-space.vercel.app,https://cospace-*-kiokamas-projects.vercel.app
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_BASE_URL=http://localhost:5173

# Google Gemini API key for the AI chatbot (https://aistudio.google.com/apikey)
GEMINI_API_KEY=<your-gemini-api-key>
# Optional: override the default model and the model used when the primary is overloaded
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# PayOS real payments (https://my.payos.vn). Leave unset to run in demo mode.
# PAYOS_CLIENT_ID=<your-payos-client-id>
# PAYOS_API_KEY=<your-payos-api-key>
# PAYOS_CHECKSUM_KEY=<your-payos-checksum-key>
# Browser redirect after paying; must reach the backend (localhost is fine for local testing)
# PAYOS_RETURN_URL=http://localhost:8080/api/payments/payos/return
# PAYOS_CANCEL_URL=http://localhost:5173/customer/checkout
